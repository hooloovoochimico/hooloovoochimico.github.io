---
import { ui, type Lang } from '../data/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const site = Astro.site!.origin;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="alternate" hreflang="en" href={`${site}/`} />
    <link rel="alternate" hreflang="it" href={`${site}/it/`} />
    <link rel="icon" href="/img/avatar.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;800&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --page: #e6e6e3;
    --sheet: #f7f7f5;
    --text: #111111;
    --muted: #5d5d5a;
    --line: #dcdcd8;
    --shadow: 0 30px 60px -30px rgb(0 0 0 / 0.25);
    /* tile palette — pastel tiles keep dark text in both themes */
    --lavender: #8784da;
    --pink: #e7a9f3;
    --teal: #a6dcd5;
    --violet: #a08ad8;
    --yellow: #f7c46c;
    --gray: #6b6b6b;
    --ink: #111111;
    --navy: #1e2a4a;
    --display: 'Unbounded', system-ui, sans-serif;
    --sans: 'Outfit', system-ui, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --page: #0d0d0d;
      --sheet: #1a1a1a;
      --text: #f2f2ee;
      --muted: #a3a39d;
      --line: #2e2e2e;
      --shadow: 0 30px 60px -30px rgb(0 0 0 / 0.8);
      --ink: #000000;
    }
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--page);
    color: var(--text);
    font: 17px/1.55 var(--sans);
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; }
  code {
    font-family: ui-monospace, monospace;
    font-size: 0.85em;
    background: rgb(255 255 255 / 0.12);
    padding: 0.05em 0.35em;
    border-radius: 4px;
  }
</style>
