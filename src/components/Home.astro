---
import Base from '../layouts/Base.astro';
import { ui, type Lang } from '../data/i18n';
import { projects, skills, jobs, earlier } from '../data/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const otherHref = lang === 'en' ? '/it/' : '/';
const mail = 'mor.angelo.mor@gmail.com';
const [featured] = projects;
const sideNav = [
  { href: '#experience', label: t.expTitle },
  { href: '#projects', label: t.nav.projects },
  { href: '#about', label: t.aboutTitle },
  { href: '#stack', label: t.stack },
  { href: '#contact', label: t.nav.contact },
];

// Turn `backticks` in summaries into <code>; summaries are our own static strings.
const fmt = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/`([^`]+)`/g, '<code>$1</code>');
---
<Base lang={lang}>
  <div class="sheet">
    <header class="bar">
      <a class="who" href={lang === 'en' ? '/' : '/it/'}>
        <img src="/img/avatar.jpg" alt="" width="40" height="40" />
        <span><strong>Angelo Moroni</strong><small>{t.badge.split('•')[0].trim()}</small></span>
      </a>
      <nav>
        <a class="lang" href={otherHref} hreflang={lang === 'en' ? 'it' : 'en'}>{t.switchLang}</a>
        <a class="pill" href="#contact">{t.ctaPrimary}</a>
      </nav>
    </header>

    <section class="hero">
      <aside class="profile">
        <p class="tab">◈ {t.aboutMe}</p>
        <div class="card">
          <ul class="side">
            {sideNav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          </ul>
          <div class="photo"><img src="/img/avatar.jpg" alt="Angelo Moroni" width="400" height="400" /></div>
          <p class="im">{t.im}<br /><strong>Angelo<br />Moroni</strong></p>
          <a class="mail" href={`mailto:${mail}`}>{mail} ↗</a>
          <svg class="badge" viewBox="0 0 100 100" aria-hidden="true">
            <defs><path id={`ring-${lang}`} d="M50,50 m-37,0 a37,37 0 1,1 74,0 a37,37 0 1,1 -74,0" /></defs>
            <circle cx="50" cy="50" r="49" />
            <text><textPath href={`#ring-${lang}`} textLength="230" lengthAdjust="spacingAndGlyphs">{t.badge.toUpperCase()}</textPath></text>
            <circle class="dot" cx="50" cy="50" r="9" />
          </svg>
        </div>
      </aside>

      <div class="right">
        <h1 class="word">Portfolio<span class="mark" aria-hidden="true"></span></h1>
        <div class="tiles">
          <a class="tile feature" href={featured.store}>
            <img src={featured.image} alt="" />
            <span class="arrow" aria-hidden="true">↗</span>
            <span class="cap">{t.featured} · {featured.name}</span>
          </a>
          <div class="stats">
            <div class="tile teal corner"><b>{t.stats[0].n}</b><span>{t.stats[0].label}</span></div>
            <div class="tile violet corner"><b>{t.stats[1].n}</b><span>{t.stats[1].label}</span></div>
          </div>
          <a class="tile gray corner small" href="#projects">
            <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="currentColor" d="M4 2.5v19l17-9.5z" /></svg>
            <span>{t.stats[2].n} {t.stats[2].label}</span>
          </a>
          <div class="tile ink ai">
            <span class="orb" aria-hidden="true"></span>
            <div class="tile yellow corner">
              <b>AI</b>
              <span>{t.aiTile}<br />Claude Code · OpenCode + Z.ai</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="intro">
      <h2 class="display">{t.headline}</h2>
      <p>{t.tagline}</p>
    </section>

    <section id="experience">
      <h2 class="display sect">{t.expTitle}<span class="mark" aria-hidden="true"></span></h2>
      <p class="lead">{t.expIntro}</p>
      <div class="jobs">
        {jobs.map((j) => (
          <article class:list={['tile', 'job', 'corner', j.tone]}>
            <p class="years">{j.years}</p>
            <h3>{j.product}</h3>
            <p class="role">{j.role}</p>
            <p>{j.summary[lang]}</p>
            <div class="links">
              <span class:list={['status', j.status]}>{j.status === 'live' ? t.statusLive : t.statusClosed}</span>
              {j.link && <a href={j.link}>{t.visit} ↗</a>}
            </div>
          </article>
        ))}
      </div>
      <div class="earlier">
        <h3>{t.earlierTitle}</h3>
        {earlier.map((e) => <p><span>{e.years}</span>{e.text[lang]}</p>)}
      </div>
    </section>

    <section id="projects">
      <h2 class="display sect">{t.projectsTitle}<span class="mark" aria-hidden="true"></span></h2>
      <div class="bento">
        {projects.map((p, i) => (
          <article class:list={['tile', 'proj', 'corner', p.tone, { big: i === 0 }]}>
            {p.image && <img src={p.image} alt="" loading="lazy" class:list={['shot', { pixel: p.name === 'Yellow Racer', icon: i === 0 }]} />}
            <h3>{p.name}</h3>
            <p set:html={fmt(p.summary[lang])} />
            <p class="tags">{p.tags.join(' · ')}</p>
            <div class="links">
              {p.store && <a href={p.store}>{t.store} ↗</a>}
              {p.repo && <a href={p.repo}>{t.code} ↗</a>}
              {p.live && <a href={p.live}>{t.live} ↗</a>}
            </div>
          </article>
        ))}
        <div id="stack" class="tile lavender stack">
          <h3>{t.skillsTitle}</h3>
          {skills.map((s) => (
            <p><strong>{s.group[lang]}</strong> {s.items.join(' · ')}</p>
          ))}
        </div>
      </div>
    </section>

    <section id="about" class="about">
      <h2 class="display sect">{t.aboutTitle}<span class="mark" aria-hidden="true"></span></h2>
      <div class="cols">
        {t.about.map((para) => <p>{para}</p>)}
      </div>
    </section>

    <section id="contact" class="tile yellow contact">
      <h2 class="display">{t.contactTitle}</h2>
      <p>{t.contactText}</p>
      <a class="pill" href={`mailto:${mail}`}>{t.contactCta}</a>
      <p class="links">
        <a href="https://www.linkedin.com/in/angelomoroni/">LinkedIn ↗</a>
        <a href="https://github.com/hooloovoochimico">GitHub ↗</a>
      </p>
    </section>

    <footer>© {new Date().getFullYear()} Angelo Moroni</footer>
  </div>
</Base>

<style>
  .sheet {
    max-width: 1180px;
    margin: 32px auto;
    padding: 28px;
    background: var(--sheet);
    border-radius: 22px;
    box-shadow: var(--shadow);
  }
  @media (max-width: 640px) {
    .sheet { margin: 0; border-radius: 0; padding: 16px; }
  }
  section { margin-top: 72px; }
  .display { font-family: var(--display); font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; }
  .mark {
    display: inline-block; width: 0.32em; height: 0.32em; margin-left: 0.08em;
    border-top: 0.07em solid currentColor; border-right: 0.07em solid currentColor;
    vertical-align: top; transform: translateY(0.12em);
  }

  /* top bar */
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .who { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .who img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; }
  .who span { display: flex; flex-direction: column; line-height: 1.2; }
  .who small { color: #2f9a5b; font-size: 0.85rem; }
  .bar nav { display: flex; align-items: center; gap: 16px; }
  .lang { text-decoration: none; color: var(--muted); }
  .lang:hover { color: var(--text); }
  .pill {
    display: inline-block; background: var(--text); color: var(--sheet);
    padding: 12px 24px; border-radius: 999px; text-decoration: none; font-weight: 500;
  }
  .pill:hover { opacity: 0.85; }

  /* hero */
  .hero { display: grid; grid-template-columns: minmax(280px, 380px) 1fr; gap: 24px; margin-top: 32px; }
  .profile { display: flex; flex-direction: column; }
  .tab {
    align-self: flex-start; margin: 0; font-size: 0.85rem; font-weight: 500;
    padding: 8px 18px 6px 16px; background: var(--lavender); color: #fff; border-radius: 14px 14px 0 0;
  }
  .card {
    flex: 1; position: relative; background: var(--lavender); color: #fff;
    border-radius: 0 18px 18px 18px; padding: 28px 24px 24px 56px;
  }
  .side {
    position: absolute; left: 14px; top: 24px; bottom: 24px; margin: 0; padding: 0; list-style: none;
    display: flex; flex-direction: column; justify-content: space-around;
  }
  .side a {
    display: block; writing-mode: vertical-rl; transform: rotate(180deg); text-decoration: none;
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; color: #fff;
    background: #111; padding: 10px 5px; border-radius: 999px; transition: background 0.2s, color 0.2s;
  }
  .side a:hover { background: var(--yellow); color: #111; }
  .photo {
    width: min(220px, 70%); aspect-ratio: 1; margin: 0 auto 20px; border-radius: 50%;
    background: var(--pink); border: 6px solid rgb(255 255 255 / 0.9); overflow: hidden;
  }
  .photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .im { font-family: var(--display); font-weight: 500; font-size: 1.6rem; line-height: 1.1; margin: 0 0 16px; }
  .im strong { font-weight: 700; font-size: 2.1rem; }
  .mail { font-size: 0.85rem; color: #fff; text-decoration: none; border-bottom: 1px solid rgb(255 255 255 / 0.5); }
  .badge { position: absolute; right: 18px; bottom: 18px; width: 92px; height: 92px; animation: spin 18s linear infinite; }
  .badge circle { fill: #111; }
  .badge .dot { fill: #fff; }
  .badge text { fill: #fff; font: 600 8px var(--sans); }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .badge { animation: none; } }

  .word { font-family: var(--display); font-weight: 800; font-size: clamp(3rem, 9vw, 7.2rem); line-height: 0.95; margin: 0 0 20px; letter-spacing: -0.04em; }

  .tiles { display: grid; grid-template-columns: repeat(6, 1fr); grid-auto-rows: minmax(130px, auto); gap: 16px; }
  .tile { border-radius: 16px; position: relative; overflow: hidden; }
  .corner::after {
    content: ''; position: absolute; top: 12px; right: 12px; width: 9px; height: 9px;
    border-top: 2px solid currentColor; border-right: 2px solid currentColor; opacity: 0.55;
  }
  .feature { grid-column: 1 / 5; grid-row: span 2; background: var(--navy); display: grid; place-items: center; text-decoration: none; color: #fff; min-height: 260px; }
  .feature img { width: 46%; max-width: 220px; border-radius: 24px; }
  .arrow {
    position: absolute; top: 14px; right: 14px; width: 44px; height: 44px; border-radius: 50%;
    background: rgb(255 255 255 / 0.92); color: #111; display: grid; place-items: center; font-size: 1.3rem;
    transition: transform 0.2s;
  }
  .feature:hover .arrow { transform: translate(2px, -2px); }
  .cap { position: absolute; left: 16px; bottom: 14px; font-size: 0.85rem; opacity: 0.85; }
  .stats { grid-column: 5 / 7; grid-row: span 2; display: grid; gap: 16px; }
  .stats .tile, .ai .yellow { padding: 18px; display: flex; flex-direction: column; justify-content: flex-end; color: #111; }
  .tile b { font-family: var(--display); font-size: 2rem; line-height: 1; }
  .tile b + span { font-size: 0.85rem; margin-top: 6px; }
  .small { grid-column: 1 / 3; color: #fff; text-decoration: none; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; text-align: center; font-size: 0.9rem; padding: 16px; }
  .ai { grid-column: 3 / 7; background: var(--ink); display: grid; grid-template-columns: 1fr 1.25fr; align-items: stretch; }
  .orb {
    width: 84px; aspect-ratio: 1; margin: auto; border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, #ffd1f0, #e86fae 35%, #5b6cf0 70%, #1d1d6b);
    box-shadow: 0 0 40px rgb(232 111 174 / 0.4);
  }
  .ai .yellow { border-radius: 16px; }

  .teal { background: var(--teal); color: #111; }
  .violet { background: var(--violet); color: #111; }
  .yellow { background: var(--yellow); color: #111; }
  .pink { background: var(--pink); color: #111; }
  .lavender { background: var(--lavender); color: #fff; }
  .gray { background: var(--gray); color: #fff; }
  .ink { background: var(--ink); color: #fff; }
  .navy { background: var(--navy); color: #fff; }

  /* intro */
  .intro { display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; align-items: end; }
  .intro h2 { font-size: clamp(1.7rem, 3.4vw, 2.6rem); margin: 0; }
  .intro p { margin: 0; color: var(--muted); font-size: 1.1rem; }

  /* projects */
  .sect { font-size: clamp(2rem, 5vw, 3.4rem); margin: 0 0 24px; }
  .bento { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .proj { padding: 22px; display: flex; flex-direction: column; }
  .proj.big { grid-column: span 2; grid-row: span 2; justify-content: center; padding: 40px; }
  .shot { width: calc(100% + 44px); margin: -22px -22px 18px; height: 170px; object-fit: cover; object-position: top; display: block; }
  .shot.pixel { object-fit: contain; image-rendering: pixelated; background: #000; }
  .shot.icon { width: 160px; height: 160px; margin: 0 0 28px; border-radius: 34px; }
  .proj h3 { font-family: var(--display); font-weight: 700; font-size: 1.15rem; margin: 0 0 10px; padding-right: 20px; }
  .proj.big h3 { font-size: 2.2rem; }
  .proj.big .links { margin-top: 20px; }
  .proj p { margin: 0 0 12px; font-size: 0.95rem; opacity: 0.88; }
  .proj.big p { font-size: 1.1rem; }
  .proj .tags { font-size: 0.8rem; opacity: 0.7; }
  .links { display: flex; flex-wrap: wrap; gap: 16px; margin-top: auto; font-weight: 600; }
  .links a { text-decoration: none; }
  .links a:hover { text-decoration: underline; }
  .stack { grid-column: span 2; padding: 22px; }
  .stack h3 { font-family: var(--display); margin: 0 0 12px; font-size: 1.15rem; }
  .stack p { margin: 0 0 8px; font-size: 0.95rem; }
  .stack strong { display: inline-block; min-width: 120px; }

  /* experience */
  .lead { margin: -12px 0 24px; color: var(--muted); font-size: 1.1rem; }
  .jobs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .job { padding: 26px; display: flex; flex-direction: column; }
  .job .years { font-size: 0.85rem; opacity: 0.75; margin: 0 0 18px; }
  .job h3 { font-family: var(--display); font-weight: 800; font-size: clamp(2.4rem, 4.5vw, 3.4rem); line-height: 1; margin: 0 0 10px; letter-spacing: -0.03em; }
  .job .role { font-weight: 600; font-size: 0.9rem; opacity: 1; margin: 0 0 14px; }
  .job p { margin: 0 0 16px; font-size: 0.95rem; opacity: 0.88; }
  .status { font-size: 0.78rem; font-weight: 600; padding: 3px 10px; border-radius: 999px; border: 1.5px solid currentColor; }
  .status.live::before { content: '● '; color: #2f9a5b; }
  .status.closed { opacity: 0.7; }
  .links { align-items: center; }
  .earlier { margin-top: 16px; border: 1px solid var(--line); border-radius: 16px; padding: 20px 24px; display: grid; grid-template-columns: auto 1fr 1fr; gap: 8px 28px; align-items: baseline; }
  .earlier h3 { font-family: var(--display); font-size: 1rem; margin: 0; }
  .earlier p { margin: 0; font-size: 0.95rem; color: var(--muted); }
  .earlier span { display: block; font-weight: 600; color: var(--text); font-size: 0.85rem; }

  /* about */
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .cols p { margin: 0; font-size: 1.1rem; }

  /* contact */
  .contact { padding: 48px 32px; text-align: center; }
  .contact h2 { font-size: clamp(1.7rem, 4vw, 2.8rem); margin: 0 0 16px; }
  .contact > p { max-width: 620px; margin: 0 auto 28px; }
  .contact .pill { background: #111; color: #fff; }
  .contact .links { justify-content: center; margin-top: 24px; }

  footer { margin-top: 32px; color: var(--muted); font-size: 0.85rem; text-align: center; }

  @media (max-width: 900px) {
    .hero, .intro, .cols, .jobs, .earlier { grid-template-columns: 1fr; }
    .bento { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .bento { grid-template-columns: 1fr; }
    .proj.big, .stack { grid-column: auto; grid-row: auto; }
    .tiles { grid-template-columns: 1fr 1fr; }
    .feature { grid-column: 1 / 3; grid-row: auto; min-height: 220px; }
    .stats { grid-column: 1 / 3; grid-row: auto; grid-template-columns: 1fr 1fr; }
    .small { grid-column: 1 / 3; }
    .ai { grid-column: 1 / 3; }
    .card { padding-left: 48px; }
  }
</style>
