---
import Base from '../layouts/Base.astro';
import { ui, type Lang } from '../data/i18n';
import { projects, archive, skills } from '../data/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const otherHref = lang === 'en' ? '/it/' : '/';

// Turn `backticks` in summaries into <code>; summaries are our own static strings.
const fmt = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/`([^`]+)`/g, '<code>$1</code>');
---
<Base lang={lang}>
  <header class="wrap top">
    <a class="logo" href={lang === 'en' ? '/' : '/it/'}>&gt;_ chemickypes</a>
    <nav>
      <a href="#projects">{t.nav.projects}</a>
      <a href="#skills">{t.nav.skills}</a>
      <a href="#contact">{t.nav.contact}</a>
      <a class="lang" href={otherHref} hreflang={lang === 'en' ? 'it' : 'en'}>{t.switchLang}</a>
    </nav>
  </header>

  <main>
    <section class="wrap hero">
      <p class="prompt">$ whoami</p>
      <h1>{t.hello} <span>Angelo Moroni</span></h1>
      <p class="tagline">{t.tagline}</p>
      <p class="meta">{t.role} · {t.location}</p>
    </section>

    <section id="projects" class="wrap">
      <h2>{t.projectsTitle}</h2>
      <p class="intro">{t.projectsIntro}</p>
      <div class="grid">
        {projects.map((p) => (
          <article class="card">
            {p.image && <img src={p.image} alt="" loading="lazy" class:list={['shot', { pixel: p.name === 'Yellow Racer' }]} />}
            <div class="body">
              <h3>{p.name}</h3>
              <p set:html={fmt(p.summary[lang])} />
              <ul class="tags">{p.tags.map((tag) => <li>{tag}</li>)}</ul>
              <div class="links">
                <a href={p.repo}>{t.code} →</a>
                {p.live && <a href={p.live}>{t.live} →</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="skills" class="wrap">
      <h2>{t.skillsTitle}</h2>
      <div class="skills">
        {skills.map((s) => (
          <div>
            <h3>{s.group[lang]}</h3>
            <ul class="tags">{s.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section class="wrap">
      <h2>{t.olderTitle}</h2>
      <p class="intro">{t.olderIntro}</p>
      <ul class="archive">
        {archive.map((a) => (
          <li><a href={a.repo}>{a.name}</a><span>{a.lang} · ★ {a.stars}</span></li>
        ))}
      </ul>
    </section>

    <section id="contact" class="wrap contact">
      <h2>{t.contactTitle}</h2>
      <p>{t.contactText}</p>
      <p class="links">
        <a href="https://github.com/chemickypes">GitHub</a>
        <a href="https://www.linkedin.com/in/angelomoroni/">LinkedIn</a>
        <a href="mailto:mor.angelo.mor@gmail.com">mor.angelo.mor@gmail.com</a>
      </p>
    </section>
  </main>

  <footer class="wrap">© {new Date().getFullYear()} Angelo Moroni</footer>
</Base>

<style>
  .wrap { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
  section.wrap { padding-top: 56px; padding-bottom: 56px; }
  h2 { font-size: 1.6rem; margin: 0 0 4px; letter-spacing: -0.01em; }
  .intro { color: var(--muted); margin: 0 0 24px; }

  .top { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding-top: 20px; padding-bottom: 20px; }
  .logo { font-family: var(--mono); font-weight: 600; color: var(--text); text-decoration: none; }
  nav { display: flex; gap: 18px; flex-wrap: wrap; font-size: 0.95rem; }
  nav a { color: var(--muted); text-decoration: none; }
  nav a:hover { color: var(--text); }
  nav .lang { color: var(--accent); font-weight: 500; }

  section.hero { padding-top: 72px; }
  .prompt { font-family: var(--mono); color: var(--accent); margin: 0 0 8px; }
  .hero h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); line-height: 1.1; margin: 0 0 16px; letter-spacing: -0.02em; }
  .tagline { font-size: 1.2rem; max-width: 640px; margin: 0 0 12px; }
  .meta { color: var(--muted); margin: 0; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; }
  .shot { width: 100%; height: 200px; object-fit: cover; object-position: top; background: #000; display: block; }
  .shot.pixel { object-fit: contain; image-rendering: pixelated; }
  .body { padding: 20px; display: flex; flex-direction: column; flex: 1; }
  .card h3 { margin: 0 0 8px; font-size: 1.15rem; }
  .card p { margin: 0 0 16px; color: var(--muted); font-size: 0.95rem; }
  .links { display: flex; flex-wrap: wrap; gap: 16px; margin-top: auto; font-weight: 500; }
  .links a { text-decoration: none; }

  .tags { list-style: none; padding: 0; margin: 0 0 16px; display: flex; flex-wrap: wrap; gap: 6px; }
  .tags li { font-family: var(--mono); font-size: 0.75rem; padding: 2px 8px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); }

  .skills { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 24px; }
  .skills h3 { margin: 0 0 10px; font-size: 1rem; }

  .archive { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0 24px; }
  .archive li { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--border); }
  .archive a { text-decoration: none; font-weight: 500; overflow-wrap: anywhere; }
  .archive span { color: var(--muted); font-family: var(--mono); font-size: 0.85rem; white-space: nowrap; }

  .contact p { margin: 0 0 8px; }
  footer { color: var(--muted); font-size: 0.85rem; padding-top: 24px; padding-bottom: 40px; border-top: 1px solid var(--border); }
</style>
